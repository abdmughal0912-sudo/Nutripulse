# Change this before any shared or internet-facing deployment.
# This is used only to create the first Administrator; Dietitians are then admin-approved.
NUTRIPULSE_ADMIN_SETUP_CODE=replace-with-a-long-private-setup-code

# Optional FastAPI protection. Clients send this as the X-API-Key header.
NUTRIPULSE_API_KEY=replace-with-a-second-long-random-secret

# Comma-separated browser origins allowed to call FastAPI.
NUTRIPULSE_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Time used by meal reminders. Pakistan is UTC+5.
NUTRIPULSE_UTC_OFFSET_HOURS=5

# Assigned Dietitians remain live for five minutes after their last authenticated heartbeat.
NUTRIPULSE_PRESENCE_TTL_SECONDS=300

# Required for reboot-safe storage on ephemeral cloud hosts such as Streamlit
# Community Cloud. Leave unset for a local SQLite installation.
# NUTRIPULSE_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional approved assistant API. External transfer still requires Customer consent in the UI.
# NUTRIPULSE_ASSISTANT_API_URL=https://approved-service.example/ask
# NUTRIPULSE_ASSISTANT_API_KEY=replace-with-secret

# Optional extra trusted domains for the web-insights extractor.
# NUTRIPULSE_SCRAPER_DOMAINS=example.gov,university.edu

# Docker Compose sets this automatically. Uncomment for a custom local path.
# NUTRIPULSE_DATABASE_PATH=/absolute/path/to/nutripulse.db
