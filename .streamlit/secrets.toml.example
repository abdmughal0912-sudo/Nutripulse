# Copy these names into Streamlit Community Cloud → App settings → Secrets.
# Never commit the real secrets.toml file or real credentials.

NUTRIPULSE_ADMIN_SETUP_CODE = "replace-with-a-long-private-code"
NUTRIPULSE_UTC_OFFSET_HOURS = "5"

# Required on Streamlit Community Cloud. Use a private managed PostgreSQL
# connection string from Neon, Supabase, or another PostgreSQL provider.
NUTRIPULSE_DATABASE_URL = "postgresql://user:password@host/database?sslmode=require"

# Gmail SMTP example. Use a dedicated sender account with Google 2-Step
# Verification and a 16-character App Password, never the normal Gmail password.
NUTRIPULSE_SMTP_HOST = "smtp.gmail.com"
NUTRIPULSE_SMTP_PORT = "587"
NUTRIPULSE_SMTP_USERNAME = "your-sender@gmail.com"
NUTRIPULSE_SMTP_PASSWORD = "replace-with-google-app-password"
NUTRIPULSE_SMTP_SENDER_EMAIL = "your-sender@gmail.com"
NUTRIPULSE_SMTP_SENDER_NAME = "NutriPulse AI"
